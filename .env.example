# Copy to .env for local development, or set these in your host's dashboard.

# The password you type to unlock the app. Required.
APP_PASSWORD=choose-a-long-password

# Where the database lives. On Railway/Fly, mount a volume here.
DATA_DIR=./data

# Optional: extra secret mixed into the key that encrypts saved email/calendar credentials.
APP_SECRET=

# Optional: enables AI email screening without pasting the key in Settings.
ANTHROPIC_API_KEY=

# Optional: your app's public https address. Used as the contact for push services
# (otherwise it's picked up automatically when your phone turns on notifications).
PUBLIC_URL=

# Optional tuning
EMAIL_POLL_MINUTES=5
SYNC_MINUTES=30
